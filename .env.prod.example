# Пример для production. Скопировать в .env и подставить значения.
# Запуск: docker compose -f docker-compose.prod.yml up --build -d

DB_NAME=future_school_db
DB_USER=future
DB_PASSWORD=your_secure_password
DJANGO_SECRET_KEY=your_django_secret_key_at_least_50_chars

# CORS: URL фронтенда (например http://IP:3000)
FRONTEND_URL=http://localhost:3000

# MinIO Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9001
MINIO_EXTERNAL_ENDPOINT=http://localhost:9001
MINIO_MEDIA_BUCKET_NAME=media
